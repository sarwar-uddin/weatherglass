<?xml version="1.0" encoding="utf-8"?>
<!-- IBM Plex Sans (SIL OFL 1.1, see docs/branding/fonts/OFL.txt), static weights subset to
     Latin + the symbols Weatherglass uses. For View/XML use (android:fontFamily="@font/plex_sans");
     Compose uses Plex in ui/Theme.kt directly. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font android:font="@font/plex_sans_thin" android:fontStyle="normal" android:fontWeight="100" />
    <font android:font="@font/plex_sans_light" android:fontStyle="normal" android:fontWeight="300" />
    <font android:font="@font/plex_sans_regular" android:fontStyle="normal" android:fontWeight="400" />
    <font android:font="@font/plex_sans_medium" android:fontStyle="normal" android:fontWeight="500" />
    <font android:font="@font/plex_sans_semibold" android:fontStyle="normal" android:fontWeight="600" />
</font-family>
