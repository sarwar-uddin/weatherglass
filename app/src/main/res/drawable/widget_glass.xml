<?xml version="1.0" encoding="utf-8"?>
<!-- Black glass widget body: card gradient, glossy top sheen, hairline edge. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient android:angle="270" android:startColor="#F21C1C21"
                android:centerColor="#F2131316" android:endColor="#F20B0B0D" />
        </shape>
    </item>
    <item android:gravity="top" android:height="44dp">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="22dp" android:topRightRadius="22dp" />
            <gradient android:angle="270" android:startColor="#14FFFFFF" android:endColor="#00FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <stroke android:width="1dp" android:color="#33FFFFFF" />
        </shape>
    </item>
</layer-list>
